{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "customConditions": ["development"],
    "lib": ["ES2022"],
    "types": ["bun"],
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "noEmit": true,
    "paths": {
      "@demicodes/*": ["./packages/*/src/index.ts", "./crates/*/page/src/index.ts"]
    }
  },
  "include": ["packages/*/src", "scripts", "crates/plugin-browser/command-chrome/src/driver/capture"],
  "exclude": [
    "packages/browse",
    "packages/web-ui",
    "packages/plugin-sdk",
    "packages/web-gallery",
    "packages/web"
  ]
}
