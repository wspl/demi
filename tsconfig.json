{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2022"],
    "types": ["bun"],
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "noEmit": true,
    "paths": {
      "@demicodes/agent/stdio": ["./packages/agent/src/protocol/stdio-transport.ts"],
      "@demicodes/shell/storage": ["./packages/shell/src/storage.ts"],
      "@demicodes/shell/host-fs": ["./packages/shell/src/host-fs.ts"],
      "@demicodes/shell/testing": ["./packages/shell/src/testing.ts"],
      "@demicodes/command-loader/build": ["./packages/command-loader/src/build.ts"],
      "@demicodes/host-virtual/node": ["./packages/host-virtual/src/node.ts"],
      "@demicodes/host-virtual/testing": ["./packages/host-virtual/src/testing.ts"],
      "@demicodes/runner/serve": ["./packages/runner/src/serve/index.ts"],
      "@demicodes/runner-protocol/msgpack": ["./packages/runner-protocol/src/codec.ts"],
      "@demicodes/runner/testing": ["./packages/runner/src/testing.ts"],
      "@demicodes/*": ["./packages/*/src/index.ts"]
    }
  },
  "include": ["packages/*/src"],
  "exclude": ["packages/web-ui", "packages/web"]
}
