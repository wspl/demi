{
  "additionalProperties": false,
  "description": "A failed operation, or a failed item of a batch such as a page of\n`content.fetch`.",
  "properties": {
    "code": {
      "type": "string",
      "enum": [
        "invalid_input",
        "tab_not_found",
        "tab_busy",
        "stale_ref",
        "stale_cursor",
        "stale_inventory",
        "stale_tools",
        "target_not_found",
        "ambiguous_target",
        "not_actionable",
        "timeout",
        "dialog_blocked",
        "dialog_not_found",
        "invalid_dialog_action",
        "history_boundary",
        "navigation_failed",
        "protected_value",
        "side_effect_rejected",
        "unsupported_result",
        "unsupported_capability",
        "cdp_method_denied",
        "output_exists",
        "io_error",
        "result_too_large",
        "partial_failure",
        "driver_error",
        "browser_unavailable",
        "browser_lost",
        "cancelled",
        "outcome_unknown"
      ],
      "description": "Why an operation failed. Each cause keeps its own code."
    },
    "message": {
      "type": "string"
    },
    "details": {
      "type": "object",
      "properties": {
        "action": {
          "type": "string",
          "enum": [
            "not_started",
            "completed",
            "unknown"
          ],
          "description": "How far an action's input got when it failed: not delivered, delivered\nwith a later wait failing, or lost with the connection after delivery\nbegan."
        },
        "tab": {
          "type": "string"
        },
        "url": {
          "type": "string",
          "description": "The tab's URL when the action failed."
        },
        "condition": {
          "type": "string",
          "description": "The element condition that was not met."
        },
        "interceptor": {
          "type": "string",
          "description": "What intercepted the pointer instead of the target."
        },
        "count": {
          "type": "integer",
          "format": "uint",
          "minimum": 0,
          "description": "How many elements an ambiguous target matched."
        },
        "delivered": {
          "type": "integer",
          "format": "uint",
          "minimum": 0,
          "description": "How many characters `type` delivered before it failed."
        },
        "debuggingCallers": {
          "type": "array",
          "items": {
            "type": "integer",
            "format": "uint64",
            "minimum": 0
          },
          "description": "The numbers of the agents whose debugging connections hold the tab\nwhen a command on it times out."
        },
        "directory": {
          "type": "string"
        },
        "manifest": {
          "type": "string"
        },
        "files": {
          "type": "array",
          "items": {
            "description": "An asset `assets.export` saved.",
            "type": "object",
            "properties": {
              "id": {
                "type": "string"
              },
              "path": {
                "type": "string"
              },
              "bytes": {
                "type": "integer",
                "format": "uint",
                "minimum": 0
              },
              "mimeType": {
                "type": "string"
              }
            },
            "additionalProperties": false,
            "required": [
              "id",
              "path",
              "bytes",
              "mimeType"
            ]
          }
        }
      },
      "description": "What a failure knows beyond its code and message."
    }
  },
  "required": [
    "code",
    "message"
  ],
  "title": "BrowserFailure",
  "type": "object"
}
