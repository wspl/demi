 {
  "name": "a null field",
  "schema": {
   "type": "object",
   "additionalProperties": false,
   "properties": {
    "field": {
     "type": "null"
    }
   }
  },
  "want": "input \"field\": has type \"null\", outside the command input subset"
 },
 {
  "name": "bounds",
  "schema": {
   "type": "object",
   "additionalProperties": false,
   "properties": {
    "field": {
