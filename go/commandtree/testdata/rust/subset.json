 {
  "name": "an array without items",
  "schema": {
   "type": "object",
   "additionalProperties": false,
   "properties": {
    "field": {
     "type": "array"
    }
   }
  },
  "want": "input \"field\": is an array without items"
 },
 {
  "name": "an array of arrays",
  "schema": {
   "type": "object",
   "additionalProperties": false,
