      "type": "string"
     }
    }
   }
  },
  "want": "input \"field\": has items but is not an array"
 },
 {
  "name": "a string enum",
  "schema": {
   "type": "object",
   "additionalProperties": false,
   "properties": {
    "field": {
     "type": "string",
     "enum": [
      "a",
      "b"
     ]
    }
   }
  },
  "want": ""
 },
 {
  "name": "an enum with null",
  "schema": {
   "type": "object",
   "additionalProperties": false,
   "properties": {
    "field": {
     "type": "string",
     "enum": [
      "a",
      null
     ]
    }
   }
  },
  "want": "input \"field\": allows null; an optional field is absent instead"
 },
 {
  "name": "an enum of numbers in a string",
  "schema": {
   "type": "object",
   "additionalProperties": false,
   "properties": {
    "field": {
     "type": "string",
     "enum": [
      "a",
      1
     ]
    }
   }
  },
  "want": "input \"field\": is an enum of values that are not all strings"
 },
 {
  "name": "an enum that is not a list",
  "schema": {
   "type": "object",
   "additionalProperties": false,
   "properties": {
    "field": {
     "type": "string",
     "enum": "a"
    }
   }
  },
  "declaration": {
   "declaration": "\"a\" is not of type \"array\""
  }
 },
 {
  "name": "an enum on a number",
  "schema": {
   "type": "object",
   "additionalProperties": false,
   "properties": {
    "field": {
     "type": "integer",
