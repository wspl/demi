{
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "matches": {
      "type": "array",
      "items": {
        "description": "One accessibility node that `find` matched or `probe` found under a point.",
        "type": "object",
        "properties": {
          "ref": {
            "description": "A node reference, which `inspect`, `find` and `probe` return: `e` and\na number unique within its tab. It stays valid while its document\ndoes.",
            "type": "string",
            "pattern": "^e[1-9][0-9]{0,14}$"
          },
          "role": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "value": {
            "description": "A node's value: an input's text, or a range or progress number.",
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "number",
                "format": "double"
              }
            ]
          },
          "depth": {
            "type": "integer",
            "format": "uint",
            "minimum": 0
          },
          "states": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "bounds": {
            "description": "A node's box in viewport CSS pixels.",
            "type": "object",
            "properties": {
              "x": {
                "type": "number",
                "format": "double"
              },
              "y": {
                "type": "number",
                "format": "double"
              },
              "width": {
                "type": "number",
                "format": "double"
              },
              "height": {
                "type": "number",
                "format": "double"
              }
            },
            "additionalProperties": false,
            "required": [
              "x",
              "y",
              "width",
              "height"
            ]
          }
        },
        "additionalProperties": false,
        "required": [
          "role",
          "name",
          "depth",
          "states"
        ]
      }
    },
    "count": {
      "type": "integer",
      "format": "uint",
      "minimum": 0
    },
    "truncated": {
      "type": "boolean"
    }
  },
  "required": [
    "matches",
    "count",
    "truncated"
  ],
  "description": "What `find` answers. `count` is every current match, even when `offset`\nand `limit` return fewer.",
  "title": "FindResult"
}