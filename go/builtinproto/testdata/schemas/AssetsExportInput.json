{
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "tab": {
      "type": "string",
      "description": "Browser tab ID returned by open or tabs",
      "pattern": "^t[1-9][0-9]{0,14}$"
    },
    "inventory": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096
    },
    "id": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "kind": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "font",
          "image",
          "stylesheet",
          "video"
        ]
      }
    },
    "output-dir": {
      "type": "string",
      "description": "Output directory on the invoking Host",
      "minLength": 1,
      "maxLength": 4096
    },
    "overwrite": {
      "type": "boolean"
    },
    "timeout": {
      "type": "integer",
      "format": "uint64",
      "minimum": 1,
      "description": "Whole operation deadline in milliseconds",
      "maximum": 300000
    }
  },
  "required": [
    "tab",
    "inventory",
    "output-dir"
  ],
  "description": "`assets.export`: saves an inventory's assets to a directory with a manifest.",
  "title": "AssetsExportInput"
}