{
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "tab": {
      "type": "string",
      "description": "Browser tab ID returned by open or tabs",
      "pattern": "^t[1-9][0-9]{0,14}$"
    },
    "output": {
      "type": "string",
      "description": "New output file on this Host",
      "minLength": 1,
      "maxLength": 4096
    },
    "overwrite": {
      "type": "boolean"
    },
    "full-page": {
      "type": "boolean"
    },
    "clip": {
      "type": "string",
      "description": "CSS rectangle: x,y,width,height",
      "minLength": 1,
      "maxLength": 4096
    },
    "timeout": {
      "type": "integer",
      "format": "uint64",
      "minimum": 1,
      "description": "Whole operation deadline in milliseconds",
      "maximum": 300000
    }
  },
  "required": [
    "tab"
  ],
  "description": "`screenshot`: captures a tab's viewport, whole page or a rectangle as PNG.",
  "title": "ScreenshotInput"
}