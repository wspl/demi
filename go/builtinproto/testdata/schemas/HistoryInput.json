{
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "tab": {
      "type": "string",
      "description": "Browser tab ID returned by open or tabs",
      "pattern": "^t[1-9][0-9]{0,14}$"
    },
    "offset": {
      "type": "integer",
      "format": "uint",
      "minimum": 0
    },
    "limit": {
      "type": "integer",
      "format": "uint",
      "minimum": 1,
      "maximum": 1000
    },
    "timeout": {
      "type": "integer",
      "format": "uint64",
      "minimum": 1,
      "description": "Whole operation deadline in milliseconds",
      "maximum": 300000
    }
  },
  "required": [
    "tab"
  ],
  "description": "`history`: lists a tab's navigation entries.",
  "title": "HistoryInput"
}