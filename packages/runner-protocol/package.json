{
  "name": "@demicodes/runner-protocol",
  "description": "The Demi runner wire: MessagePack frames, the message schemas and the codec seam, shared by the backend and the runner.",
  "version": "0.20.0",
  "private": false,
  "type": "module",
  "main": "./dist/index.mjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "development": "./src/index.ts",
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    },
    "./msgpack": {
      "development": "./src/codec.ts",
      "types": "./dist/codec.d.mts",
      "import": "./dist/codec.mjs"
    },
    "./local": {
      "development": "./src/local.ts",
      "types": "./dist/local.d.mts",
      "import": "./dist/local.mjs"
    },
    "./release": {
      "development": "./src/release.ts",
      "types": "./dist/release.d.mts",
      "import": "./dist/release.mjs"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsdown"
  },
  "dependencies": {
    "@demicodes/shell": "workspace:^",
    "@demicodes/utils": "workspace:^",
    "@msgpack/msgpack": "^3.1.3",
    "zod": "^4.5.4"
  },
  "license": "Apache-2.0",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wspl/demi.git",
    "directory": "packages/runner-protocol"
  },
  "homepage": "https://github.com/wspl/demi/tree/main/packages/runner-protocol#readme",
  "bugs": "https://github.com/wspl/demi/issues"
}
