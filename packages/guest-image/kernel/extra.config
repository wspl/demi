# On top of Firecracker's microvm config for the same kernel series: what
# the guest init needs (managed-hosts.md § Lifecycle) and nothing loadable.
CONFIG_OVERLAY_FS=y
CONFIG_EXT4_FS=y
CONFIG_TMPFS=y
CONFIG_TMPFS_POSIX_ACL=y
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y
CONFIG_CGROUPS=y
CONFIG_VIRTIO_BLK=y
CONFIG_VIRTIO_NET=y
CONFIG_VIRTIO_MMIO=y
CONFIG_VSOCKETS=y
CONFIG_VIRTIO_VSOCKETS=y
CONFIG_MODULES=n
CONFIG_DRM=n
CONFIG_SOUND=n
CONFIG_WIRELESS=n
