{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:[.-][a-z0-9]+)+$"
    },
    "version": {
      "type": "string",
      "minLength": 1
    },
    "protocolVersion": {
      "type": "number",
      "const": 1
    },
    "operations": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "targets": {
      "type": "object",
      "propertyNames": {
        "type": "string",
        "enum": [
          "aarch64-apple-darwin",
          "x86_64-apple-darwin",
          "aarch64-unknown-linux-musl",
          "x86_64-unknown-linux-musl",
          "aarch64-pc-windows-msvc",
          "x86_64-pc-windows-msvc"
        ]
      },
      "additionalProperties": {
        "type": "object",
        "properties": {
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "size": {
            "type": "integer",
            "exclusiveMinimum": 0,
            "maximum": 9007199254740991
          }
        },
        "required": [
          "sha256",
          "size"
        ],
        "additionalProperties": false
      },
      "required": [
        "aarch64-apple-darwin",
        "x86_64-apple-darwin",
        "aarch64-unknown-linux-musl",
        "x86_64-unknown-linux-musl",
        "aarch64-pc-windows-msvc",
        "x86_64-pc-windows-msvc"
      ]
    }
  },
  "required": [
    "id",
    "version",
    "protocolVersion",
    "operations",
    "targets"
  ],
  "additionalProperties": false
}
