{
  "extends": ["../../tsconfig.json", "@vue/tsconfig/tsconfig.dom.json"],
  "compilerOptions": {
    "composite": false,
    "noEmit": true,
    "lib": ["ESNext", "DOM", "DOM.Iterable"],
    "types": ["vite/client", "bun"],
    "paths": {
      "@/*": ["./src/*"],
      "@demicodes/web-ui/*": ["../web-ui/src/*"],
      "@demicodes/plugin-browser/*": ["../plugin-browser/src/*"],
      "@demicodes/plugin-changes/*": ["../plugin-changes/src/*"],
      "@demicodes/plugin-file-browser/*": ["../plugin-file-browser/src/*"],
      "@demicodes/plugin-skills/*": ["../plugin-skills/src/*"],
      "@demicodes/*": ["../*/src/index.ts"]
    }
  },
  "include": ["src"],
  "exclude": ["node_modules", "dist"]
}
