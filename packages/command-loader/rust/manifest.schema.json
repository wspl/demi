{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "hash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "roots": {
      "type": "object",
      "propertyNames": {
        "type": "string",
        "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]*$"
      },
      "additionalProperties": {
        "type": "object",
        "properties": {
          "tree": {
            "$ref": "#/$defs/__schema0"
          }
        },
        "required": [
          "tree"
        ],
        "additionalProperties": false
      }
    },
    "packages": {
      "type": "object",
      "propertyNames": {
        "type": "string",
        "pattern": "^[a-f0-9]{64}$"
      },
      "additionalProperties": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:[.-][a-z0-9]+)+$"
          },
          "version": {
            "type": "string",
            "minLength": 1
          },
          "protocolVersion": {
            "type": "number",
            "const": 1
          },
          "operations": {
            "minItems": 1,
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "targets": {
            "type": "object",
            "propertyNames": {
              "type": "string",
              "enum": [
                "aarch64-apple-darwin",
                "x86_64-apple-darwin",
                "aarch64-unknown-linux-musl",
                "x86_64-unknown-linux-musl",
                "aarch64-pc-windows-msvc",
                "x86_64-pc-windows-msvc"
              ]
            },
            "additionalProperties": {
              "type": "object",
              "properties": {
                "sha256": {
                  "type": "string",
                  "pattern": "^[a-f0-9]{64}$"
                },
                "size": {
                  "type": "integer",
                  "exclusiveMinimum": 0,
                  "maximum": 9007199254740991
                }
              },
              "required": [
                "sha256",
                "size"
              ],
              "additionalProperties": false
            },
            "required": [
              "aarch64-apple-darwin",
              "x86_64-apple-darwin",
              "aarch64-unknown-linux-musl",
              "x86_64-unknown-linux-musl",
              "aarch64-pc-windows-msvc",
              "x86_64-pc-windows-msvc"
            ]
          }
        },
        "required": [
          "id",
          "version",
          "protocolVersion",
          "operations",
          "targets"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "hash",
    "roots",
    "packages"
  ],
  "additionalProperties": false,
  "$defs": {
    "__schema0": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "name": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]*$"
            },
            "summary": {
              "type": "string"
            },
            "subcommands": {
              "minItems": 1,
              "type": "array",
              "items": {
                "$ref": "#/$defs/__schema0"
              }
            }
          },
          "required": [
            "name",
            "summary",
            "subcommands"
          ],
          "additionalProperties": false
        },
        {
          "oneOf": [
            {
              "type": "object",
              "properties": {
                "name": {
                  "type": "string",
                  "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]*$"
                },
                "summary": {
                  "type": "string"
                },
                "successOutput": {
                  "type": "string"
                },
                "failureOutput": {
                  "type": "string"
                },
                "runningHint": {
                  "type": "string"
                },
                "input": {
                  "type": "object",
                  "propertyNames": {
                    "type": "string"
                  },
                  "additionalProperties": {}
                },
                "positionals": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]*$"
                  }
                },
                "stdinField": {
                  "type": "string",
                  "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]*$"
                },
                "restField": {
                  "type": "string",
                  "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]*$"
                },
                "output": {
                  "type": "object",
                  "properties": {
                    "json": {
                      "type": "object",
                      "propertyNames": {
                        "type": "string"
                      },
                      "additionalProperties": {}
                    }
                  },
                  "additionalProperties": false
                },
                "kind": {
                  "type": "string",
                  "const": "rpc"
                }
              },
              "required": [
                "name",
                "summary",
                "kind"
              ],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "name": {
                  "type": "string",
                  "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]*$"
                },
                "summary": {
                  "type": "string"
                },
                "successOutput": {
                  "type": "string"
                },
                "failureOutput": {
                  "type": "string"
                },
                "runningHint": {
                  "type": "string"
                },
                "input": {
                  "type": "object",
                  "propertyNames": {
                    "type": "string"
                  },
                  "additionalProperties": {}
                },
                "positionals": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]*$"
                  }
                },
                "stdinField": {
                  "type": "string",
                  "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]*$"
                },
                "restField": {
                  "type": "string",
                  "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]*$"
                },
                "output": {
                  "type": "object",
                  "properties": {
                    "json": {
                      "type": "object",
                      "propertyNames": {
                        "type": "string"
                      },
                      "additionalProperties": {}
                    }
                  },
                  "additionalProperties": false
                },
                "kind": {
                  "type": "string",
                  "const": "native"
                },
                "binding": {
                  "type": "object",
                  "properties": {
                    "package": {
                      "type": "string",
                      "pattern": "^[a-z0-9]+(?:[.-][a-z0-9]+)+$"
                    },
                    "operation": {
                      "type": "string",
                      "minLength": 1
                    },
                    "descriptorHash": {
                      "type": "string",
                      "pattern": "^[a-f0-9]{64}$"
                    }
                  },
                  "required": [
                    "package",
                    "operation",
                    "descriptorHash"
                  ],
                  "additionalProperties": false
                }
              },
              "required": [
                "name",
                "summary",
                "kind",
                "binding"
              ],
              "additionalProperties": false
            }
          ]
        }
      ]
    }
  }
}
