diff --git a/include/openssl/ssl.h b/include/openssl/ssl.h
index dd81949..83b0301 100644
--- a/include/openssl/ssl.h
+++ b/include/openssl/ssl.h
@@ -5267,6 +5267,19 @@ OPENSSL_EXPORT void SSL_CTX_set_retain_only_sha256_of_client_certs(SSL_CTX *ctx,
 // GREASE. See RFC 8701.
 OPENSSL_EXPORT void SSL_CTX_set_grease_enabled(SSL_CTX *ctx, int enabled);
 
+// SSL_CTX_set_grease_sigalgs_enabled configures whether ClientHellos on |ctx|
+// list a GREASE value first in signature_algorithms, as Chrome does.
+OPENSSL_EXPORT void SSL_CTX_set_grease_sigalgs_enabled(SSL_CTX *ctx,
+                                                       int enabled);
+
+// SSL_CTX_set1_advertised_sigalgs sets signature algorithms that ClientHellos
+// on |ctx| list before the verification preferences, without accepting them
+// from the peer, so that the list matches a browser's. It returns one on
+// success and zero on allocation failure.
+OPENSSL_EXPORT int SSL_CTX_set1_advertised_sigalgs(SSL_CTX *ctx,
+                                                   const uint16_t *prefs,
+                                                   size_t num_prefs);
+
 // SSL_CTX_set_permute_extensions configures whether sockets on |ctx| should
 // permute extensions. For now, this is only implemented for the ClientHello.
 OPENSSL_EXPORT void SSL_CTX_set_permute_extensions(SSL_CTX *ctx, int enabled);
diff --git a/ssl/extensions.cc b/ssl/extensions.cc
index 1240cc6..87b8340 100644
--- a/ssl/extensions.cc
+++ b/ssl/extensions.cc
@@ -980,6 +980,22 @@ static bool ext_ticket_add_serverhello(SSL_HANDSHAKE *hs, CBB *out) {
 //
 // https://tools.ietf.org/html/rfc5246#section-7.4.1.4.1
 
+// A browser-like ClientHello lists a GREASE value and algorithms it does not
+// verify with before its verification preferences.
+static bool add_advertised_sigalgs(const SSL_HANDSHAKE *hs, CBB *out) {
+  const SSL_CTX *ctx = hs->ssl->ctx.get();
+  if (ctx->grease_sigalgs_enabled &&
+      !CBB_add_u16(out, ssl_get_grease_value(hs, ssl_grease_sigalg))) {
+    return false;
+  }
+  for (uint16_t sigalg : ctx->advertised_sigalgs) {
+    if (!CBB_add_u16(out, sigalg)) {
+      return false;
+    }
+  }
+  return true;
+}
+
 static bool ext_sigalgs_add_clienthello(const SSL_HANDSHAKE *hs, CBB *out,
                                         CBB *out_compressible,
                                         ssl_client_hello_type_t type) {
@@ -995,6 +1011,7 @@ static bool ext_sigalgs_add_clienthello(const SSL_HANDSHAKE *hs, CBB *out,
   if (!CBB_add_u16(out_compressible, TLSEXT_TYPE_signature_algorithms) ||
       !CBB_add_u16_length_prefixed(out_compressible, &contents) ||
       !CBB_add_u16_length_prefixed(&contents, &sigalgs_cbb) ||
+      !add_advertised_sigalgs(hs, &sigalgs_cbb) ||
       !tls12_add_verify_sigalgs(hs, &sigalgs_cbb) ||
       !CBB_flush(out_compressible)) {
     return false;
diff --git a/ssl/internal.h b/ssl/internal.h
index c80e565..b0fc96b 100644
--- a/ssl/internal.h
+++ b/ssl/internal.h
@@ -1612,7 +1612,8 @@ enum ssl_grease_index_t {
   ssl_grease_version,
   ssl_grease_ticket_extension,
   ssl_grease_ech_config_id,
-  ssl_grease_last_index = ssl_grease_ech_config_id,
+  ssl_grease_sigalg,
+  ssl_grease_last_index = ssl_grease_sigalg,
 };
 
 enum tls12_server_hs_state_t {
@@ -4020,6 +4021,11 @@ struct ssl_ctx_st : public bssl::RefCounted<ssl_ctx_st> {
 
   // verify_sigalgs, if not empty, is the set of signature algorithms
   // accepted from the peer in decreasing order of preference.
+  // advertised_sigalgs are signature algorithms a ClientHello lists before
+  // |verify_sigalgs| without accepting them from the peer, so that the list
+  // matches a browser's.
+  bssl::Array<uint16_t> advertised_sigalgs;
+
   bssl::Array<uint16_t> verify_sigalgs;
 
   // retain_only_sha256_of_client_certs is true if we should compute the SHA256
@@ -4046,6 +4052,10 @@ struct ssl_ctx_st : public bssl::RefCounted<ssl_ctx_st> {
   // grease_enabled is whether GREASE (RFC 8701) is enabled.
   bool grease_enabled : 1;
 
+  // grease_sigalgs_enabled is whether a ClientHello lists a GREASE value first in
+  // signature_algorithms, as Chrome does.
+  bool grease_sigalgs_enabled : 1;
+
   // permute_extensions is whether to permute extensions when sending messages.
   bool permute_extensions : 1;
 
diff --git a/ssl/ssl_lib.cc b/ssl/ssl_lib.cc
index 117b9c9..60834b2 100644
--- a/ssl/ssl_lib.cc
+++ b/ssl/ssl_lib.cc
@@ -396,6 +396,7 @@ ssl_ctx_st::ssl_ctx_st(const SSL_METHOD *ssl_method)
       signed_cert_timestamps_enabled(false),
       channel_id_enabled(false),
       grease_enabled(false),
+      grease_sigalgs_enabled(false),
       permute_extensions(false),
       disable_second_keyshare(false),
       allow_unknown_alpn_protos(false),
@@ -3152,6 +3153,15 @@ void SSL_CTX_set_grease_enabled(SSL_CTX *ctx, int enabled) {
   ctx->grease_enabled = !!enabled;
 }
 
+void SSL_CTX_set_grease_sigalgs_enabled(SSL_CTX *ctx, int enabled) {
+  ctx->grease_sigalgs_enabled = !!enabled;
+}
+
+int SSL_CTX_set1_advertised_sigalgs(SSL_CTX *ctx, const uint16_t *prefs,
+                                    size_t num_prefs) {
+  return ctx->advertised_sigalgs.CopyFrom(bssl::Span(prefs, num_prefs));
+}
+
 void SSL_CTX_set_permute_extensions(SSL_CTX *ctx, int enabled) {
   ctx->permute_extensions = !!enabled;
 }
