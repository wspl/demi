# The backend's unit, which a server release carries in its systemd/
# (docs/delivery/upgrades.md § One release on a server). It runs the release
# /opt/demi/current points to, as the system user demi, whose demi-cloud
# group reaches the machine manager's socket, with only the capability to
# listen on a port below 1024, as behind Cloudflare. It serves its Clouds'
# runners on /run/demi-backend/runners.sock, whose directory outlives its
# restarts: each Cloud has the directory mounted, so the socket a restarted
# backend makes again reaches it. Type=notify: the backend
# reports readiness once it listens, after its migrations, which have no
# deadline; nor has its shutdown, which saves every Cloud.
[Unit]
Description=Demi backend
After=network-online.target demi-machine-manager.service
Wants=network-online.target demi-machine-manager.service

[Service]
Type=notify
User=demi
Group=demi
SupplementaryGroups=demi-cloud
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
UMask=0077
RuntimeDirectory=demi-backend
RuntimeDirectoryMode=0755
RuntimeDirectoryPreserve=yes
TimeoutStartSec=infinity
TimeoutStopSec=infinity
Restart=on-failure
RestartSec=3
EnvironmentFile=/opt/demi/config/demi.env
ExecStart=/opt/demi/current/bin/demi-backend

[Install]
WantedBy=multi-user.target
