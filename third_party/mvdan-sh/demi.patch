+func TestReadAndExternalEditsAreExcluded(t *testing.T) {
+	dir := t.TempDir()
+	if err := os.WriteFile(filepath.Join(dir, "input"), []byte("read"), 0600); err != nil {
+		t.Fatal(err)
+	}
+	var recorder demiRecorder
