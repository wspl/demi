{
  "buckets": {
    "6f3d2a1e-8b47-4c59-9e10-2d7c5a9b3f61": {
      "name": "Bucket"
    }
  },
  "services": {
    "c1a94e7d-30b2-4f86-a5d1-7e82b6c0f4a3": {
      "name": "Demi",
      "icon": "https://raw.githubusercontent.com/demi-sh/demi/main/packages/web-ui/src/assets/app-icon.png",
      "source": {
        "image": "ghcr.io/demi-sh/demi:latest"
      },
      "deploy": {
        "healthcheckPath": "/api/update",
        "healthcheckTimeout": 300,
        "restartPolicyType": "ON_FAILURE",
        "restartPolicyMaxRetries": 10
      },
      "networking": {
        "serviceDomains": {
          "<hasDomain>:3271": {
            "port": 3271
          }
        },
        "tcpProxies": {}
      },
      "volumeMounts": {
        "9b7e1c44-52ad-4e03-8f6a-1c3d9e7a2b58": {
          "mountPath": "/opt/demi"
        }
      },
      "variables": {
        "DEMI_BACKEND_PUBLIC_URL": {
          "description": "The address Demi is reached at.",
          "defaultValue": "https://${{RAILWAY_PUBLIC_DOMAIN}}",
          "isOptional": false
        },
        "DEMI_STORAGE": {
          "description": "Keeps attachments and media in the Railway Bucket.",
          "defaultValue": "s3",
          "isOptional": false
        },
        "DEMI_S3_BUCKET": {
          "description": "The Railway Bucket's name.",
          "defaultValue": "${{Bucket.BUCKET}}",
          "isOptional": false
        },
        "DEMI_S3_ENDPOINT": {
          "description": "The Railway Bucket's endpoint.",
          "defaultValue": "${{Bucket.ENDPOINT}}",
          "isOptional": false
        },
        "DEMI_S3_REGION": {
          "description": "The Railway Bucket's region.",
          "defaultValue": "${{Bucket.REGION}}",
          "isOptional": false
        },
        "AWS_ACCESS_KEY_ID": {
          "description": "The Railway Bucket's key id.",
          "defaultValue": "${{Bucket.ACCESS_KEY_ID}}",
          "isOptional": false
        },
        "AWS_SECRET_ACCESS_KEY": {
          "description": "The Railway Bucket's secret key.",
          "defaultValue": "${{Bucket.SECRET_ACCESS_KEY}}",
          "isOptional": false
        },
        "PORT": {
          "description": "The port Railway's health check and domain reach Demi on.",
          "defaultValue": "3271",
          "isOptional": false
        },
        "RAILWAY_DEPLOYMENT_DRAINING_SECONDS": {
          "description": "How long a redeploy waits for Demi to save its Clouds.",
          "defaultValue": "120",
          "isOptional": false
        }
      }
    }
  }
}
