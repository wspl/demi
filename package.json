{
  "name": "demi",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/coding-agent",
    "packages/agent",
    "packages/core",
    "packages/utils",
    "packages/provider",
    "packages/provider-codex",
    "packages/provider-claude-code",
    "packages/provider-openai-api",
    "packages/provider-anthropic-api",
    "packages/provider-google",
    "packages/provider-grok-build",
    "packages/shell",
    "packages/backend",
    "packages/host-virtual",
    "packages/tinybash",
    "packages/command-loader",
    "packages/runner-protocol",
    "packages/host-remote",
    "packages/runner",
    "packages/web-ui",
    "packages/web"
  ],
  "scripts": {
    "check:registry": "bun run scripts/check-public-registry.ts",
    "typecheck": "tsgo --noEmit",
    "typecheck:web": "bun --filter @demicodes/web-ui typecheck && bun --filter @demicodes/web typecheck",
    "build": "bun --filter '@demicodes/*' build",
    "llms": "bun run scripts/build-llms.ts",
    "changeset": "changeset",
    "changeset:version": "changeset version",
    "release": "bun run scripts/release.ts",
    "web:dev": "bun --filter @demicodes/web dev",
    "web:server": "bun run packages/web/src/server/index.ts",
    "test": "bun test --conditions development packages/utils/src packages/core/src packages/provider/src packages/agent/src packages/shell/src packages/tinybash/src packages/command-loader/src packages/runner-protocol/src packages/host-remote/src packages/host-virtual/src packages/runner/src packages/coding-agent/src packages/provider-codex/src packages/provider-claude-code/src packages/provider-openai-api/src packages/provider-anthropic-api/src packages/provider-google/src packages/provider-grok-build/src packages/web-ui/src packages/web/src",
    "fixtures:compaction:build": "bun run packages/agent/fixtures/compaction/build-fixture.ts",
    "fixtures:compaction:verify": "bun run packages/agent/fixtures/compaction/verify-compaction.ts",
    "fixtures:compaction:verify-switch": "bun run packages/agent/fixtures/compaction/verify-window-switch.ts"
  },
  "devDependencies": {
    "@changesets/cli": "^2.31.0",
    "@types/bun": "^1.3.14",
    "@typescript/native-preview": "^7.0.0-dev.20260618.1",
    "oxc-parser": "^0.137.0",
    "tsdown": "^0.22.3",
    "unrun": "^0.3.1",
    "zod": "^4.0.0"
  },
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wspl/demi.git"
  },
  "homepage": "https://github.com/wspl/demi#readme",
  "bugs": "https://github.com/wspl/demi/issues"
}
