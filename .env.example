# Local secrets for real-provider harnesses (never commit)
DEEPSEEK_API_KEY=
# DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
# DEEPSEEK_FLASH_MODEL=deepseek-v4-flash

# Development sign-in: the web application's sign-in page fills these in
# during development (packages/web/vite.config.ts)
DEMI_DEV_EMAIL=
DEMI_DEV_PASSWORD=

# A real model the development backend adds beside Echo, over an
# OpenAI-compatible Chat Completions endpoint; all four or none
# (docs/backend/backend.md § One-command development backend). `bun run dev`
# loads this file.
DEMI_DEV_PROVIDER_BASE_URL=
DEMI_DEV_PROVIDER_API_KEY=
DEMI_DEV_PROVIDER_MODEL=
DEMI_DEV_PROVIDER_CONTEXT_WINDOW=

# Cloud: the machine manager on this Linux machine (docs/backend/backend.md § Development backend)
# DEMI_MACHINE_MANAGER_SOCKET=/run/demi-cloud/machines.sock
# DEMI_BACKEND_PUBLIC_URL=http://<address the Cloud guest reaches>:3271
# On a Mac with Lima (docs/guides/mac-development.md):
# DEMI_MACHINE_MANAGER_SOCKET=/Users/me/.lima/demi-machine-manager/sock/demi-machine-manager.sock
