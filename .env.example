# Local secrets for real-provider harnesses (never commit)
DEEPSEEK_API_KEY=
# DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
# DEEPSEEK_FLASH_MODEL=deepseek-v4-flash

# Development sign-in: the web application's sign-in page fills these in
# during development (packages/web/vite.config.ts)
DEMI_DEV_EMAIL=
DEMI_DEV_PASSWORD=

# Cloud on macOS: the machine manager inside Lima (docs/cloud/setup.md § Mac backend with local Lima)
# DEMI_MACHINES_SOCKET=/Users/me/.lima/demi-machines/sock/demi-machines.sock
# DEMI_BACKEND_PUBLIC_URL=http://192.168.5.2:3271
