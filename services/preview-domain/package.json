{
  "name": "@demicodes/preview-domain",
  "description": "The preview domain service: a Cloudflare Worker that keeps preview namespaces and serves the versioned boot page, client script and forwarder.",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev --port ${DEMI_PREVIEW_PORT:-8787} --var PREVIEW_DOMAIN:demi-preview.localhost:${DEMI_PREVIEW_PORT:-8787}",
    "typecheck": "tsgo --noEmit -p tsconfig.json && tsgo --noEmit -p tsconfig.test.json"
  },
  "dependencies": {
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261007.1",
    "wrangler": "^4.148.0"
  },
  "license": "Apache-2.0"
}
