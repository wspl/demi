          "params": {
            "additionalProperties": false,
            "description": "`renew { expose }` and `remove { expose }`.",
            "properties": {
              "expose": {
                "type": "string",
                "description": "The expose's id."
              }
            },
            "required": [
              "expose"
            ],
            "title": "ExposeCall",
            "type": "object"
          },
          "result": {
