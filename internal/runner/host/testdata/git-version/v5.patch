+// closeRepository releases v5 storage: Repository has no Close method and
+// storage.Storer does not include it, although filesystem storage implements it.
+func closeRepository(r *git.Repository) error {
+	if closer, ok := r.Storer.(io.Closer); ok {
+		return closer.Close()
+	}
+	return nil
+}
