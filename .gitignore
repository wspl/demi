docs/internal/
docs/reviews/

# Test & coverage
coverage/
.test-cache/

# Bundler / tooling caches
.vite/
.cache/
# Wrangler's local state: the development server's KV and its builds
.wrangler/
docs/.vitepress/dist/

# Packaging artifacts (`npm pack` / `bun pm pack`)
*.tgz

# Logs
*.log

